@inject IStringLocalizer<SharedResource> localizer

<div class="d-flex flex-column">
    <table class="table">
        <thead>
            <tr>
                <th>
                    @localizer["monday"]
                </th>
                <th>
                    @localizer["tuesday"]
                </th>
                <th>
                    @localizer["wednesday"]
                </th>
                <th>
                    @localizer["thursday"]
                </th>
                <th>
                    @localizer["friday"]
                </th>
                <th class="weekend">
                    @localizer["saturday"]
                </th>
                <th class="weekend">
                    @localizer["sunday"]
                </th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Days.GetLength(0); i++)
            {
                <tr>
                    @for (int j = 0; j < 7; j++)
                    {
                        string classes = Days[i, j].Type == DayViewModel.DayType.Workday ? "workday" : "dayoff";
                        if (j == 5 || j == 6)
                        {
                            classes += " weekend";
                        }
                        <td class="@classes">
                            @if (ShowMonth)
                            {
                                @Days[i, j].Date.ToString("dd.MM")
                            }
                            else
                            {
                                @Days[i, j].Date.ToString("dd")
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
    <div class="d-flex flex-column legend p-3 pt-2 pb-2 mt-0 flex-grow-1">
        <div class="d-flex align-items-center">
            <span class="square workday"></span> - @localizer["legend.workday"]
        </div>
        <div class="d-flex align-items-center">
            <span class="square dayoff"></span> - @localizer["legend.dayoff"]
        </div>
        <div class="d-flex align-items-center">
            <span class="square transfer"></span>- @localizer["legend.transfer"]
        </div>
    </div>
</div>
@code {
    [Parameter]
    public required DayViewModel[,] Days
    {
        get;
        set
        {
            ArgumentNullException.ThrowIfNull(value);
            if (value.GetLength(1) != 7)
            {
                throw new ArgumentException("Days table must be suit for 7-days week");
            }
            field = value;
        }
    }

    [Parameter]
    public bool ShowMonth { get; set; }
}
